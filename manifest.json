{
  "manifest_version": 3,
  "name": "Captcher Recorder",
  "short_name": "Captcher",
  "homepage_url": "https://captcher.app",
  "version": "1.0.0",
  "description": "Record a product flow as an interactive Captcher walkthrough, straight from your browser.",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "152",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Open the Captcher recorder"
  }
}
